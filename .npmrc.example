# PIM packages are published to the dedicated Adobe Artifactory repository.
# The tracked root .npmrc contains this registry mapping and no credentials.
@pim:registry=https://artifactory-uw2.adobeitc.com/artifactory/api/npm/npm-adobe-pim-release/

# Authenticate in your user-level ~/.npmrc; never add a token to the repository:
# npm login \
#   --registry=https://artifactory-uw2.adobeitc.com/artifactory/api/npm/npm-adobe-pim-release/ \
#   --auth-type=web \
#   --scope=@pim

# ado-pim is unscoped, so pass the registry explicitly when installing it:
# npm install -g ado-pim \
#   --registry=https://artifactory-uw2.adobeitc.com/artifactory/api/npm/npm-adobe-pim-release/
