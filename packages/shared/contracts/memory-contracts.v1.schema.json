{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pim.local/schemas/memory-contracts.v1.schema.json",
  "title": "PIM memory v1 contracts",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "TenantV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "ConsumerV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_id", "harness_version", "workflow_version", "adapter_version", "consumer_run_id"],
      "properties": {
        "harness_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "harness_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workflow_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "consumer_run_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "ProducerV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_id", "harness_version", "workflow_version", "adapter_version"],
      "properties": {
        "harness_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "harness_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workflow_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "CodebaseApplicabilityV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id"],
      "properties": {
        "repository_id": { "type": "string", "pattern": "^github\\.com/[a-z0-9_.-]+/[a-z0-9_.-]+$", "maxLength": 256 },
        "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "components": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "paths": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "symbols": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "task_classes": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
      }
    },
    "HarnessApplicabilityV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_id"],
      "properties": {
        "harness_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "harness_version_range": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workflow_version_range": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter_version_range": { "type": "string", "minLength": 1, "maxLength": 128 },
        "configuration_ids": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "model_ids": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "tool_ids": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    },
    "OrgApplicabilityV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "policy_owner", "effective_from"],
      "properties": {
        "audience": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "policy_owner": { "type": "string", "minLength": 1, "maxLength": 160 },
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_until": { "type": ["string", "null"], "format": "date-time" },
        "project_ids": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "repository_ids": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^github\\.com/[a-z0-9_.-]+/[a-z0-9_.-]+$", "maxLength": 256 } }
      }
    },
    "MemoryContentV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "details", "rationale"],
      "properties": {
        "summary": { "type": "string", "minLength": 10, "maxLength": 500 },
        "details": { "type": "string", "minLength": 30, "maxLength": 8000 },
        "rationale": { "type": "string", "minLength": 10, "maxLength": 4000 }
      }
    },
    "CompatibilityV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_version_range", "workflow_version_range"],
      "properties": {
        "harness_version_range": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workflow_version_range": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter_version_range": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "AnchorRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "digest"],
      "properties": {
        "type": { "type": "string", "enum": ["path", "symbol", "commit", "test"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "value": { "type": "string", "minLength": 1, "maxLength": 512 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "ValidationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "type": "string", "enum": ["repository_anchors", "stable_failure_fingerprint", "policy_owner_review"] },
        "anchor_refs": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/AnchorRefV1" } },
        "failure_fingerprint": { "type": "string", "minLength": 8, "maxLength": 512 }
      }
    },
    "EvidenceSummaryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strength", "ref_count"],
      "properties": {
        "strength": { "type": "string", "enum": ["observed", "reviewed", "verified_merge", "verified_merge_and_test", "verified_runtime"] },
        "ref_count": { "type": "integer", "minimum": 0, "maximum": 256 }
      }
    },
    "FreshnessV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_confirmed_at"],
      "properties": {
        "last_confirmed_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "LifecycleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["active", "stale", "superseded", "revoked", "expired"] }
      }
    },
    "MemoryEvaluationArmV1": {
      "type": "string",
      "enum": ["shadow", "memory_off", "memory_on"]
    },
    "MemorySearchItemV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_version", "plane", "kind", "summary", "lifecycle", "applicability", "exceptions", "compatibility", "validation", "evidence_summary", "freshness", "prompt_eligible", "detail_href", "match_reasons"],
      "properties": {
        "record_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "record_version": { "type": "integer", "minimum": 1 },
        "plane": { "const": "codebase" },
        "kind": { "type": "string", "enum": ["decision", "constraint", "anti_pattern", "test_strategy"] },
        "summary": { "type": "string", "minLength": 10, "maxLength": 500 },
        "lifecycle": { "$ref": "#/$defs/LifecycleV1" },
        "applicability": { "$ref": "#/$defs/CodebaseApplicabilityV1" },
        "exceptions": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "compatibility": { "$ref": "#/$defs/CompatibilityV1" },
        "validation": { "$ref": "#/$defs/ValidationV1" },
        "evidence_summary": { "$ref": "#/$defs/EvidenceSummaryV1" },
        "freshness": { "$ref": "#/$defs/FreshnessV1" },
        "prompt_eligible": { "type": "boolean" },
        "detail_href": { "type": "string", "minLength": 1, "maxLength": 512 },
        "match_reasons": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
      }
    },
    "MemoryCandidateV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "client_candidate_id", "plane", "kind", "content", "applicability", "validation", "exceptions", "source_run_ids", "evidence_refs", "extraction", "activation_requirement_requested"],
      "properties": {
        "schema_version": { "const": "pim.memory-candidate.v1" },
        "client_candidate_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "plane": { "type": "string", "enum": ["codebase", "harness", "org"] },
        "kind": { "type": "string", "enum": ["decision", "constraint", "anti_pattern", "test_strategy"] },
        "content": { "$ref": "#/$defs/MemoryContentV1" },
        "applicability": { "oneOf": [{ "$ref": "#/$defs/CodebaseApplicabilityV1" }, { "$ref": "#/$defs/HarnessApplicabilityV1" }, { "$ref": "#/$defs/OrgApplicabilityV1" }] },
        "validation": { "$ref": "#/$defs/ValidationV1" },
        "exceptions": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "source_run_ids": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "evidence_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "extractor_version", "confidence"],
          "properties": {
            "method": { "type": "string", "enum": ["deterministic", "model_then_deterministic_validation", "authorized_review"] },
            "extractor_version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "activation_requirement_requested": { "type": "string", "enum": ["verified_merge", "authorized_review", "manual_policy_owner"] },
        "extensions": { "type": "object", "maxProperties": 16, "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
      }
    },
    "EvidenceRefV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "uri", "digest", "origin_id", "occurred_at", "source_authority"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["git_diff", "test_run", "failure", "review", "incident", "policy_decision"] },
        "uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "origin_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "source_authority": { "type": "string", "enum": ["observed", "verified", "authorized_review"] }
      }
    },
    "FiestaCodeEvidenceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manifest_id", "digest", "refs"],
      "properties": {
        "schema_version": { "const": "fiesta.code-evidence.v2" },
        "manifest_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "refs": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/EvidenceRefV2" } }
      }
    },
    "MemoryCapabilitiesV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_revision", "server_build", "supported_schemas", "planes", "kinds", "limits", "evidence_resolver_types", "activation_policies", "feedback_version", "temporal_modes", "deprecations"],
      "properties": {
        "schema_version": { "const": "pim.memory-capabilities.v1" },
        "contract_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "server_build": { "type": "string", "minLength": 1, "maxLength": 128 },
        "supported_schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "responses"],
          "properties": {
            "requests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
            "responses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
          }
        },
        "planes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["codebase", "harness", "org"] } },
        "kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["decision", "constraint", "anti_pattern", "test_strategy"] } },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_receipt_bytes", "max_candidate_bytes", "max_evidence_refs", "max_feedback_items", "max_search_tokens", "max_search_items"],
          "properties": {
            "max_receipt_bytes": { "type": "integer", "minimum": 1 },
            "max_candidate_bytes": { "type": "integer", "minimum": 1 },
            "max_evidence_refs": { "type": "integer", "minimum": 1 },
            "max_feedback_items": { "type": "integer", "minimum": 1 },
            "max_search_tokens": { "type": "integer", "minimum": 1 },
            "max_search_items": { "type": "integer", "minimum": 1 }
          }
        },
        "evidence_resolver_types": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["github", "ci", "https_immutable"] } },
        "activation_policies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["verified_merge", "authorized_review", "manual_policy_owner"] } },
        "feedback_version": { "const": "pim.memory-feedback.v1" },
        "temporal_modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "const": "current" } },
        "deprecations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "deprecated_at", "sunset_at"],
            "properties": {
              "schema_version": { "type": "string", "minLength": 1, "maxLength": 128 },
              "deprecated_at": { "type": "string", "format": "date-time" },
              "sunset_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "MemoryPromptPolicyUpdateV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "expected_revision", "enabled", "kill_switch", "automatic_activation_enabled", "canary_percentage", "allowed_repository_ids", "allowed_kinds", "max_prompt_items", "max_prompt_tokens"],
      "properties": {
        "schema_version": { "const": "pim.memory-prompt-policy-update.v1" },
        "expected_revision": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" },
        "kill_switch": { "type": "boolean" },
        "automatic_activation_enabled": { "type": "boolean" },
        "canary_percentage": { "type": "integer", "minimum": 0, "maximum": 100 },
        "allowed_repository_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^github\\.com/[a-z0-9_.-]+/[a-z0-9_.-]+$", "maxLength": 256 }
        },
        "allowed_kinds": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["decision", "constraint", "anti_pattern", "test_strategy"] }
        },
        "max_prompt_items": { "type": "integer", "minimum": 1, "maximum": 3 },
        "max_prompt_tokens": { "type": "integer", "minimum": 1, "maximum": 1200 }
      }
    },
    "MemoryPromptPolicyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project_id", "policy_revision", "enabled", "kill_switch", "automatic_activation_enabled", "canary_percentage", "allowed_repository_ids", "allowed_kinds", "max_prompt_items", "max_prompt_tokens", "global_enabled", "effective_enabled", "updated_at"],
      "properties": {
        "schema_version": { "const": "pim.memory-prompt-policy.v1" },
        "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policy_revision": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" },
        "kill_switch": { "type": "boolean" },
        "automatic_activation_enabled": { "type": "boolean" },
        "canary_percentage": { "type": "integer", "minimum": 0, "maximum": 100 },
        "allowed_repository_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^github\\.com/[a-z0-9_.-]+/[a-z0-9_.-]+$", "maxLength": 256 }
        },
        "allowed_kinds": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["decision", "constraint", "anti_pattern", "test_strategy"] }
        },
        "max_prompt_items": { "type": "integer", "minimum": 1, "maximum": 3 },
        "max_prompt_tokens": { "type": "integer", "minimum": 1, "maximum": 1200 },
        "global_enabled": { "type": "boolean" },
        "effective_enabled": { "type": "boolean" },
        "updated_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "MemoryReleaseGateSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representative_sample_count", "reviewed_candidate_count", "known_boundary_leakage_count", "provenance_completeness_rate", "typed_round_trip_conformance_rate", "unresolved_active_pointer_count", "extraction_precision_rate", "resolvable_evidence_rate", "harmful_or_stale_prompt_exposure_rate", "critical_policy_violation_count", "evidence_bypass_incident_count", "critical_harm_incident_count", "pim_outage_blocked_execution_count", "pim_outage_lost_queued_receipt_count", "memory_on_off_pair_count", "task_pass_lift_percentage_points", "paired_95ci_lower_percentage_points", "pass_rate_delta_percentage_points", "noninferiority_margin_percentage_points", "efficiency_reduction_rate", "same_record_helpful_independent_runs", "latency_or_cost_increase_rate", "disciplined_no_lift_cycles"],
      "properties": {
        "representative_sample_count": { "type": "integer", "minimum": 0 },
        "reviewed_candidate_count": { "type": "integer", "minimum": 0 },
        "known_boundary_leakage_count": { "type": "integer", "minimum": 0 },
        "provenance_completeness_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "typed_round_trip_conformance_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "unresolved_active_pointer_count": { "type": "integer", "minimum": 0 },
        "extraction_precision_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "resolvable_evidence_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "harmful_or_stale_prompt_exposure_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "critical_policy_violation_count": { "type": "integer", "minimum": 0 },
        "evidence_bypass_incident_count": { "type": "integer", "minimum": 0 },
        "critical_harm_incident_count": { "type": "integer", "minimum": 0 },
        "pim_outage_blocked_execution_count": { "type": ["integer", "null"], "minimum": 0 },
        "pim_outage_lost_queued_receipt_count": { "type": ["integer", "null"], "minimum": 0 },
        "memory_on_off_pair_count": { "type": ["integer", "null"], "minimum": 0 },
        "task_pass_lift_percentage_points": { "type": ["number", "null"], "minimum": -100, "maximum": 100 },
        "paired_95ci_lower_percentage_points": { "type": ["number", "null"], "minimum": -100, "maximum": 100 },
        "pass_rate_delta_percentage_points": { "type": ["number", "null"], "minimum": -100, "maximum": 100 },
        "noninferiority_margin_percentage_points": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "efficiency_reduction_rate": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "same_record_helpful_independent_runs": { "type": ["integer", "null"], "minimum": 0 },
        "latency_or_cost_increase_rate": { "type": ["number", "null"], "minimum": -1, "maximum": 10 },
        "disciplined_no_lift_cycles": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "MemoryReleaseGateEvaluationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "stage", "dataset_digest", "metric_snapshot"],
      "properties": {
        "schema_version": { "const": "pim.memory-release-gate-evaluation.v1" },
        "stage": { "type": "string", "enum": ["pre_canary", "expansion"] },
        "dataset_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "metric_snapshot": { "$ref": "#/$defs/MemoryReleaseGateSnapshotV1" }
      }
    },
    "MemoryReleaseGateDecisionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "project_id", "decision_id", "stage", "decision", "status", "dataset_digest", "metric_snapshot_digest", "reasons", "created_at"],
      "properties": {
        "schema_version": { "const": "pim.memory-release-gate-decision.v1" },
        "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decision_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "stage": { "type": "string", "enum": ["pre_canary", "expansion"] },
        "decision": { "type": "string", "enum": ["continue", "pause"] },
        "status": { "type": "string", "enum": ["pass", "fail", "insufficient_data"] },
        "dataset_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "metric_snapshot_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "reasons": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "MemorySearchV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "consumer", "tenant", "plane", "applicability", "task", "temporal", "budget", "options"],
      "properties": {
        "schema_version": { "const": "pim.memory-search.v1" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "consumer": { "$ref": "#/$defs/ConsumerV1" },
        "tenant": { "$ref": "#/$defs/TenantV1" },
        "plane": { "type": "string", "enum": ["codebase", "harness", "org"] },
        "applicability": { "oneOf": [{ "$ref": "#/$defs/CodebaseApplicabilityV1" }, { "$ref": "#/$defs/HarnessApplicabilityV1" }, { "$ref": "#/$defs/OrgApplicabilityV1" }] },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query", "task_class"],
