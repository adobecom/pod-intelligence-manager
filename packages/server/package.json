{
  "name": "@pim/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "retrieval-eval": "tsx scripts/kg-retrieval-eval.ts",
    "project-search-eval": "node --import tsx scripts/project-search-eval.ts",
    "test:project-search-eval": "vitest run --config eval/project-search/vitest.config.ts",
    "typecheck:project-search-eval": "tsc --project tsconfig.project-search-eval.json --noEmit",
    "rescore-legacy": "tsx src/scripts/rescore-legacy-patterns.ts",
    "seed-project-search": "tsx src/scripts/seed-project-search.ts",
    "seed-memory": "tsx src/scripts/seed-memory.ts",
    "inventory-legacy-graphs": "node --import tsx src/scripts/inventory-legacy-graphs.ts",
    "build-reviewed-memory-resolutions": "node --import tsx src/scripts/build-reviewed-memory-resolutions.ts",
    "prepare-reviewed-memory-repositories": "node --import tsx src/scripts/prepare-reviewed-memory-repositories.ts",
    "migrate-legacy-memory": "node --import tsx src/scripts/migrate-legacy-memory.ts",
    "memory-retention": "node --import tsx src/scripts/memory-retention.ts",
    "scrub-project-search": "tsx src/scripts/scrub-project-search.ts",
    "skill-conflict-pr-check": "tsx src/scripts/skill-conflict-pr-check.ts",
    "skill-catalog:bundle": "tsx src/scripts/build-skill-catalog-bundle.ts",
    "skill-catalog:upload": "tsx src/scripts/upload-skill-catalog-bundle.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@pim/mcp-server": "workspace:*",
    "@pim/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@slack/web-api": "^7.15.1",
    "dotenv": "^17.4.2",
    "entities": "4.5.0",
    "fastify": "^5.12.1",
    "jose": "^5.9.6",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
