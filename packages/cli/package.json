{
  "name": "@pim/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "pim": "./bin/pim.mjs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/pim.bundle.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.0",
    "@pim/sdk": "workspace:*",
    "@pim/shared": "workspace:*",
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
