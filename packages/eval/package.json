{
  "name": "@pim/eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "freeze": "tsx src/cli/freeze.ts",
    "lic-freeze": "tsx src/cli/lic-freeze.ts",
    "lic-migrate": "tsx src/cli/lic-migrate.ts",
    "freeze-kg-retrieval-oracle": "tsx scripts/freeze-kg-retrieval-oracle.ts",
    "freeze-kg-recall-oracle": "tsx scripts/freeze-kg-recall-oracle.ts",
    "make-holdout": "tsx src/cli/make-holdout.ts",
    "make-haiku-holdout": "tsx src/cli/make-haiku-holdout.ts",
    "audit-protocol": "tsx src/cli/audit-protocol.ts",
    "audit-holdout": "tsx src/cli/audit-holdout.ts",
    "audit-run": "tsx src/cli/audit-run.ts",
    "analyze-run": "tsx src/cli/audit-run.ts --type=analyze",
    "judge-patches": "tsx src/cli/judge-patches.ts",
    "run-eval": "tsx src/cli/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@pim/sdk": "workspace:*",
    "@pim/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
