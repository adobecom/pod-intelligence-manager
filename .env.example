# Copy to `.env` at the repo root. The API server loads that file on startup
# (see packages/server/src/load-env.ts). Optional override: packages/server/.env

# ── LLM (required for AI-powered merge/conflict/knowledge agents) ──
# Without this key the system still works using deterministic fallbacks.
AWS_REGION=us-west-2
BEDROCK_MODEL_FAST=
BEDROCK_MODEL_SMART=
AWS_BEARER_TOKEN_BEDROCK=

# ── Knowledge Graph Embeddings (optional) ──
# Titan Text Embeddings v2 via Bedrock; uses AWS_BEARER_TOKEN_BEDROCK above.
# Valid: 256 | 512 | 1024 (default: 512)
# EMBEDDING_DIMENSIONS=512

# ── Slack notifications (optional) ──
# Bot token (xoxb-...) and channel ID. If unset, Slack integration is silently skipped.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Base URL used in Slack notification links (defaults to http://localhost:5173)
PIM_UI_URL=http://localhost:5173

# ── Server ──
PORT=4000

# ── Auth ──
# `trust` (default) upserts a synthetic dev@local user on every request — for
# local dev only. Flip to `ims` to verify Adobe IMS JWTs via JWKS; the UI's
# VITE_AUTH_MODE and the CLI both key off /api/health so they'll flip with you.
AUTH_MODE=trust

# ── Server IMS client (JWT verification) ──
# Used by the server to validate incoming access tokens via IMS JWKS.
# This should be a web-app IMS client registered for your project's redirect URLs.
# Not used for the CLI login flow — see CLI client below.
IMS_CLIENT_ID=
# stg1 | prod — picks the correct IMS JWKS endpoint + issuer
IMS_ENV=stg1
# Optional: override the expected JWT issuer (defaults to the IMS endpoint for IMS_ENV)
# IMS_EXPECTED_ISSUER=
# Reject tokens whose client_id claim doesn't match IMS_CLIENT_ID.
# Defaults to true when IMS_CLIENT_ID is set. Set to false only if CLI and
# server intentionally use different IMS clients.
# IMS_REQUIRE_CLIENT_ID_MATCH=true
# Reject sign-ins from accounts outside this email domain. Defaults to @adobe.com.
# IMS_ALLOWED_EMAIL_DOMAIN=@adobe.com

# ── CLI IMS client (pim login browser flow) ──
# Separate from the server client because the OAuth browser flow requires
# http://localhost:9876/callback as a registered redirect URI — something a
# web-app client won't have. The server advertises these via /api/health so
# users can run `pim login` with no extra env vars on their machine.
# The client_secret is safe to expose here: CLI clients are inherently public
# (every user has it), equivalent to shipping it in the binary.
IMS_CLI_CLIENT_ID=
IMS_CLI_CLIENT_SECRET=
# Scopes for the CLI login flow. gnav is first-party only — most projects use AdobeID,openid.
# IMS_CLI_SCOPES=AdobeID,openid

# ── UI auth (NOT loaded from this file — copy to packages/ui/.env.local) ──
# Vite only reads env vars prefixed with VITE_ and located alongside the UI
# package. Must match the server's AUTH_MODE or requests will 401.
# VITE_AUTH_MODE=trust
# VITE_IMS_CLIENT_ID=ado-pim-console
# VITE_IMS_ENV=stg1
# VITE_IMS_SCOPES=AdobeID,openid

# ── Background task intervals (milliseconds) ──
ESCALATION_INTERVAL_MS=300000    # 5 min  — escalation ladder checks
LINT_INTERVAL_MS=7200000         # 2 hr   — pod health lint pass
GRAPH_REFRESH_INTERVAL_MS=1800000 # 30 min — knowledge graph community detection

# ── MCP server (only needed if running the Claude.ai artifact integration) ──
PIM_API_URL=http://localhost:4000
# Required in IMS mode. In trust mode this is ignored.
# Falls back to orgSlug from the cwd's .pim.json if unset.
# PIM_ORG_SLUG=

# ── Agents / CLI / git hooks ──
# PIM_SERVER_URL is read by the CLI and git hooks to reach the PIM API.
PIM_SERVER_URL=http://localhost:4000
# PIM_POD_ID, PIM_AGENT_ID, and PIM_SCOPE are per-workspace — set them in
# the pod directory's .env (or via `pim hooks install`) rather than here.
# PIM_POD_ID=
# PIM_AGENT_ID=
# One of: frontend | backend | design | qa | infra | pm
# PIM_SCOPE=
# Optional: if 1, git hooks fail when PIM POST fails (default is non-blocking)
# PIM_HOOK_STRICT=0

# ── Context Search (v1 uses user tokens; v2/hosted swaps to service accounts) ──
# Any unset source is silently skipped (listed in missing_sources on responses).

# Slack — per-workspace user tokens. See Victor guide Section 6 for scopes.
SLACK_USER_TOKEN_MWP=
SLACK_USER_TOKEN_AEM_ENG=
SLACK_USER_TOKEN_ADOBEDOTCOM=
# Scheduled full-thread ingestion is gated independently from live Slack search.
PROJECT_SLACK_INGESTION_ENABLED=0
# Enable only after a successful backfill/reconciliation under the current bindings.
PROJECT_SLACK_SEARCH_ENABLED=0

# Jira (basic auth: email + API token)
JIRA_BASE_URL=https://jira.corp.adobe.com
JIRA_EMAIL=
JIRA_TOKEN=
# Operator attestation: listed projects contain no issue-security audience
# narrower than the corresponding PIM project.
PROJECT_JIRA_VISIBLE_PROJECT_KEYS=

# Confluence (shares credentials with Jira when same tenant)
CONFLUENCE_BASE_URL=https://wiki.corp.adobe.com
CONFLUENCE_TOKEN=
# Optional override — defaults to JIRA_EMAIL
# CONFLUENCE_EMAIL=
# Required for project-scoped indexing/search. These are operator assertions
# that every PIM project searcher can view the listed spaces/pages.
CONFLUENCE_PROJECT_VISIBLE_SPACE_KEYS=
CONFLUENCE_PROJECT_VISIBLE_PAGE_IDS=
PROJECT_CONFLUENCE_INGESTION_ENABLED=0
# Enable only after a successful unrestricted-page reconciliation.
PROJECT_CONFLUENCE_SEARCH_ENABLED=0

# Fluffyjaws (enterprise conversational RAG — https://fluffyjaws.adobe.com)
# Session id from ~/.config/fj/session.json (run `fj login` first).
# Requires VPN. Base URL defaults to https://api.fluffyjaws.adobe.com.
FLUFFYJAWS_BASE_URL=https://api.fluffyjaws.adobe.com
FLUFFYJAWS_SESSION_ID=

# GitHub (code + issues search; scope comma-separated orgs)
GH_TOKEN=
GITHUB_SEARCH_ORGS=adobecom,adobe-rnd
# Operator attestation: every PIM project searcher can view these repositories.
PROJECT_GITHUB_VISIBLE_REPOS=

# Comma-separated operator-owned roots beneath which local Git repos may be read.
# Defaults to the server process working directory.
PROJECT_GIT_ALLOWED_ROOTS=

# Cache + rate limits
CONTEXT_SEARCH_CACHE_TTL_SEC=3600
CONTEXT_SEARCH_MAX_CONCURRENT=6
