# Copy to `.env` at the repo root. The API server loads that file on startup
# (see packages/server/src/load-env.ts). Optional override: packages/server/.env

# ── LLM (required for AI-powered merge/conflict/knowledge agents) ──
# Without this key the system still works using deterministic fallbacks.
AWS_REGION=us-west-2
BEDROCK_MODEL_FAST=
BEDROCK_MODEL_SMART=
AWS_BEARER_TOKEN_BEDROCK=

# ── Slack notifications (optional) ──
# Bot token (xoxb-...) and channel ID. If unset, Slack integration is silently skipped.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Base URL used in Slack notification links (defaults to http://localhost:5173)
COUNCIL_UI_URL=http://localhost:5173

# ── Server ──
PORT=4000

# ── Background task intervals (milliseconds) ──
ESCALATION_INTERVAL_MS=300000    # 5 min  — escalation ladder checks
LINT_INTERVAL_MS=7200000         # 2 hr   — pod health lint pass
GRAPH_REFRESH_INTERVAL_MS=1800000 # 30 min — knowledge graph community detection

# ── MCP server (only needed if running the Claude.ai artifact integration) ──
COUNCIL_API_URL=http://localhost:4000

# ── Agents / CLI / git hooks (pod workspace) ──
# Used by: council context, council report, council hooks install
COUNCIL_SERVER_URL=http://localhost:4000
COUNCIL_POD_ID=
COUNCIL_AGENT_ID=
# One of: frontend | backend | design | qa | infra | pm
COUNCIL_SCOPE=
# Optional: if 1, git hooks fail when Council POST fails (default is non-blocking)
# COUNCIL_HOOK_STRICT=0

# ── Context Search (v1 uses user tokens; v2/hosted swaps to service accounts) ──
# Any unset source is silently skipped (listed in missing_sources on responses).

# Slack — per-workspace user tokens. See Victor guide Section 6 for scopes.
SLACK_USER_TOKEN_MWP=
SLACK_USER_TOKEN_AEM_ENG=
SLACK_USER_TOKEN_ADOBEDOTCOM=

# Jira (basic auth: email + API token)
JIRA_BASE_URL=https://jira.corp.adobe.com
JIRA_EMAIL=
JIRA_TOKEN=

# Confluence (shares credentials with Jira when same tenant)
CONFLUENCE_BASE_URL=https://wiki.corp.adobe.com
CONFLUENCE_TOKEN=
# Optional override — defaults to JIRA_EMAIL
# CONFLUENCE_EMAIL=

# Fluffyjaws (enterprise conversational RAG — https://fluffyjaws.adobe.com)
# Session id from ~/.config/fj/session.json (run `fj login` first).
# Requires VPN. Base URL defaults to https://api.fluffyjaws.adobe.com.
FLUFFYJAWS_BASE_URL=https://api.fluffyjaws.adobe.com
FLUFFYJAWS_SESSION_ID=

# GitHub (code + issues search; scope comma-separated orgs)
GH_TOKEN=
GITHUB_SEARCH_ORGS=adobecom,adobe-rnd

# Cache + rate limits
CONTEXT_SEARCH_CACHE_TTL_SEC=3600
CONTEXT_SEARCH_MAX_CONCURRENT=6
