# ── LLM (required for AI-powered merge/conflict/knowledge agents) ──
# Without this key the system still works using deterministic fallbacks.
ANTHROPIC_API_KEY=

# ── Slack notifications (optional) ──
# Bot token (xoxb-...) and channel ID. If unset, Slack integration is silently skipped.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Base URL used in Slack notification links (defaults to http://localhost:5173)
COUNCIL_UI_URL=http://localhost:5173

# ── Server ──
PORT=4000

# ── Background task intervals (milliseconds) ──
ESCALATION_INTERVAL_MS=300000    # 5 min  — escalation ladder checks
LINT_INTERVAL_MS=7200000         # 2 hr   — pod health lint pass
GRAPH_REFRESH_INTERVAL_MS=1800000 # 30 min — knowledge graph community detection

# ── MCP server (only needed if running the Claude.ai artifact integration) ──
COUNCIL_API_URL=http://localhost:4000

# ── Agents / CLI / git hooks (pod workspace) ──
# Used by: council context, council report, council hooks install
COUNCIL_SERVER_URL=http://localhost:4000
COUNCIL_POD_ID=
COUNCIL_AGENT_ID=
# One of: frontend | backend | design | qa | infra | pm
COUNCIL_SCOPE=
# Optional: if 1, git hooks fail when Council POST fails (default is non-blocking)
# COUNCIL_HOOK_STRICT=0
