{
  "name": "pim-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "pim": "tsx packages/cli/src/index.ts",
    "bootstrap": "pnpm install && pnpm --filter @pim/mcp-server build && pnpm --filter ado-pim build && node scripts/link-pim-global.mjs && node scripts/bootstrap-reminder.mjs",
    "install-cli": "pnpm bootstrap"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@swc/core"]
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "turbo": "^2.9.0",
    "typescript": "^5.7.0"
  }
}
